{
  "maxWireBytes": 5000000,
  "walkPreloads": [
    "script.bundle.js",
    "assets/world.bundle.js",
    "assets/player.bundle.js",
    "assets/character-tripo.js",
    "assets/elevator-v2.js",
    "assets/mall-themes.js",
    "assets/natural-materials.js",
    "vendor/three.module.min.js",
    "vendor/GLTFLoader.js",
    "vendor/rapier.mjs"
  ],
  "criticalFiles": [
    "assets/startup-assets.pack",
    "vendor/rapier_bg.wasm",
    "../../../../assets/icons.svg",
    "../../../../version.json"
  ],
  "deferred": [
    {
      "path": "assets/shopping-cart.glb",
      "loader": "assets/push-cart.js",
      "trigger": "prepare()"
    },
    {
      "path": "assets/atrium-chandelier.glb",
      "loader": "assets/public-architecture.js",
      "trigger": "if (!chandelier.visible || requested) return;"
    },
    {
      "path": "assets/mall-directory-standee.glb",
      "loader": "assets/public-architecture.js",
      "trigger": "if (!detailsEnabled()) return;"
    },
    {
      "path": "assets/gjh-tripo-visitor-lod1.glb",
      "loader": "assets/visitor-v2-lod.js",
      "trigger": "if (entry) void entry.then(schedule);"
    },
    {
      "path": "assets/gjh-tripo-portrait.webp",
      "loader": "assets/character-tripo.js",
      "trigger": "portrait.entry.then"
    },
    {
      "path": "assets/gjh-tripo-portrait-2k.webp",
      "loader": "assets/character-tripo.js",
      "trigger": "portrait.entry.then"
    },
    {
      "path": "assets/tram/*.glb",
      "loader": "assets/tram-car.js",
      "trigger": "async function select"
    },
    {
      "path": "assets/elevator/*.glb",
      "loader": "assets/elevator-kit.js",
      "trigger": "async function select"
    },
    {
      "path": "assets/gallery-assets/upper-level/*.glb",
      "loader": "assets/upper-level.js",
      "trigger": "function loadUpperFurniture"
    },
    {
      "path": "assets/gallery-assets/*.glb",
      "loader": "assets/expanded-interiors.js",
      "trigger": "if (!detailsEnabled()) return;"
    },
    {
      "path": "data/gjh-interior-additions.json#placed",
      "loader": "assets/interior-additions.js",
      "trigger": "if (loading || !detailsEnabled()) return;"
    }
  ],
  "walkImagePreloads": [
    "assets/concourse-marble.webp",
    "assets/gogo-brand-cover.webp",
    "assets/gogo-logo.jpg",
    "assets/mili-brand-cover.webp",
    "assets/mili-logo.jpg",
    "assets/new-moon-brand-cover.webp",
    "assets/new-moon-logo.svg",
    "assets/new-moon-au-425g-front.webp",
    "assets/new-moon-mx-454g-front.webp",
    "assets/new-moon-nz-425g-front.webp",
    "assets/new-moon-sa-425g-front.webp"
  ]
}
